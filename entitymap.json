    "treatmentConcepts": [
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#substance-use-disorder",
        "name": "Substance use disorder",
        "alternateName": "SUD",
        "definition": "A health condition involving a problematic pattern of substance use that causes clinically significant impairment or distress. Diagnosis belongs to qualified clinicians."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#drug-rehab",
        "name": "Drug rehabilitation",
        "alternateName": "Drug rehab",
        "definition": "An umbrella term for organized treatment and recovery services addressing problematic drug use; it may include assessment, withdrawal management, medications, counseling, residential or outpatient care, and continuing support."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#alcohol-rehab",
        "name": "Alcohol rehabilitation",
        "alternateName": "Alcohol rehab",
        "definition": "Organized treatment and recovery services for alcohol-related problems, potentially including medically supervised withdrawal management, medications, counseling, residential or outpatient care, and continuing support."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#medical-detox",
        "name": "Medical detoxification",
        "alternateName": "Medical detox",
        "definition": "Clinical evaluation, monitoring, and treatment of intoxication or withdrawal risk. Detoxification is a stabilization phase and is not the same as a complete rehabilitation plan."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#residential-treatment",
        "name": "Residential treatment",
        "definition": "A structured treatment program in which a person lives at the program while receiving services. Residential intensity and medical capability vary by program."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#outpatient-treatment",
        "name": "Outpatient treatment",
        "definition": "Treatment delivered through scheduled visits without an overnight stay; frequency and clinical intensity vary."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#dual-diagnosis",
        "name": "Co-occurring disorder treatment",
        "alternateName": "Dual diagnosis treatment",
        "definition": "Integrated or coordinated care for substance-use needs and co-occurring mental-health conditions."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#medications-for-addiction-treatment",
        "name": "Medications for addiction treatment",
        "alternateName": "MAT",
        "definition": "Use of approved medications as part of treatment for certain substance use disorders, commonly combined with clinical and recovery support according to individual need."
      },
      {
        "id": "https://brand-north-delivery.github.io/indiana-detox-guide/entitymap.html#continuing-care",
        "name": "Continuing care",
        "alternateName": "Aftercare",
        "definition": "Ongoing services and recovery supports after an initial treatment phase, which may include outpatient care, medications, peer support, recovery housing, or monitoring."
      }
